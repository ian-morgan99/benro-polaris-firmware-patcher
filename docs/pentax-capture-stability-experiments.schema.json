{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pentax stability failure fingerprint",
  "type": "object",
  "required": [
    "experiment",
    "run_id",
    "camera",
    "attachment",
    "layer",
    "actual_software_path",
    "first_abnormal_event",
    "reproducibility"
  ],
  "properties": {
    "experiment": {"type": "string"},
    "run_id": {"type": "string"},
    "camera": {"enum": ["K-3 III", "K-1 II"]},
    "attachment": {"enum": ["PC", "POLARIS"]},
    "layer": {"enum": ["A", "B", "C"]},
    "actual_software_path": {"type": "string", "minLength": 1},
    "enumeration_verified": {"type": "boolean"},
    "first_abnormal_ts": {"type": ["integer", "null"]},
    "first_abnormal_event": {"type": "string"},
    "camera_state": {"type": ["string", "null"]},
    "active_command": {"type": ["string", "null"]},
    "candidate_state": {"type": ["object", "null"]},
    "pgphoto_state": {"type": ["object", "null"]},
    "usb_state": {"type": ["object", "null"]},
    "later_symptom": {"type": ["string", "null"]},
    "recovery_required": {
      "enum": ["none", "session-reset", "process-restart", "usb-reconnect", "camera-power-cycle", "polaris-reboot", "unknown"]
    },
    "reproducibility": {
      "type": "object",
      "required": ["failures", "runs"],
      "properties": {
        "failures": {"type": "integer", "minimum": 0},
        "runs": {"type": "integer", "minimum": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"layer": {"enum": ["A", "B"]}}},
      "then": {"properties": {"attachment": {"const": "PC"}}}
    },
    {
      "if": {"properties": {"layer": {"const": "C"}}},
      "then": {"properties": {"attachment": {"const": "POLARIS"}}}
    }
  ]
}
