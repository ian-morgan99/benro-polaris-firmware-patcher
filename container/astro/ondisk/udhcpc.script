#!/bin/sh
# ===========================================================================
#  udhcpc.script -- apply a DHCP lease on the STATION interface.
#
#  BusyBox udhcpc does not configure anything itself; it obtains the lease and
#  then calls this. Without it the lease is granted and silently discarded --
#  "lease of 10.0.0.110 obtained" in the log and no address on the interface,
#  which reads exactly like a DHCP failure and is not one.
#
#  Deliberately does NOT touch the access point or its subnet: the Benro app
#  talks directly to 192.168.0.1 and must keep working whatever the home
#  network hands us. A default route is added only when there is none, so the
#  device gains internet access without ever displacing the AP path.
# ===========================================================================
LOG=/app/sd/polaris-wifi/apsta.log
RESOLV=/etc/resolv.conf
# Staging path for the replacement. It lives outside /etc so a crash mid-write
# cannot leave a stray file in the config directory.
#
# Do NOT describe this as tmpfs: on this firmware there is no tmpfs at all.
# `mount | grep tmpfs` returns only `devtmpfs on /dev`, and `df /tmp` reports
# ubi0:ubifs -- /tmp is the same root flash volume as /etc. Nothing here avoids
# flash writes by living in /tmp; the savings come entirely from not writing at
# all when the content is unchanged.
TMPRESOLV=/tmp/polaris-resolv.conf
# Written into the file we create, so deconfig can tell "a resolv.conf we made"
# from one the firmware or an operator made, and only remove its own.
MARK="# added by polaris-wifi udhcpc.script"

write_resolv() {
    # $dns is a space-separated list BusyBox udhcpc exports in the same
    # environment as $ip/$router/$subnet. Nothing else on this firmware consumes
    # it: there is no /etc/resolv.conf and no /usr/share/udhcpc/default.script,
    # so without this a joined network reaches raw IPs and resolves nothing --
    # nslookup falls back to 127.0.0.1 and fails (issue #281).
    [ -n "$dns" ] || return 0

    want="$MARK"
    for ns in $dns; do want="$want
nameserver $ns"; done

    # Compare in memory BEFORE touching flash. Building the string first is the
    # whole point: an unchanged lease then writes nothing whatsoever. The previous
    # version wrote a temp file and only then ran cmp, so it hit UBIFS on every
    # renew -- roughly hourly on a two-hour lease -- which is exactly what this
    # guard exists to prevent. $(cat) strips trailing newlines on both sides, so
    # the comparison does not depend on how the existing file was terminated.
    if [ -f "$RESOLV" ] && [ "$want" = "$(cat "$RESOLV" 2>/dev/null)" ]; then
        return 0
    fi

    if ! printf '%s\n' "$want" > "$TMPRESOLV" 2>/dev/null; then
        rm -f "$TMPRESOLV" 2>/dev/null
        return 1
    fi
    # Same filesystem, so this is a rename rather than copy+unlink. The failure
    # path must return non-zero: silently removing the temp and falling through
    # with status 0 would let the caller log "dns applied" over a resolver that
    # was never written.
    if ! mv "$TMPRESOLV" "$RESOLV" 2>/dev/null; then
        rm -f "$TMPRESOLV" 2>/dev/null
        return 1
    fi
    return 0
}

case "$1" in
  bound|renew)
    /sbin/ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}"
    if [ -n "$router" ] && ! /sbin/route -n 2>/dev/null | grep -q '^0\.0\.0\.0'; then
        /sbin/route add default gw "$router" dev "$interface" 2>/dev/null
    fi
    # Report what actually happened. A lease that was applied but whose resolver
    # could not be written is a different fault from "no DNS offered", and the old
    # line printed the offered servers as though they were live.
    if write_resolv; then
        dnsstate="${dns:-none}"
    else
        dnsstate="FAILED to write $RESOLV (offered: ${dns:-none})"
    fi
    echo "$(date '+%m-%d %H:%M:%S') lease $ip/${subnet} applied to $interface (gw ${router:-none}, dns $dnsstate)" >> "$LOG"
    ;;
  deconfig)
    /sbin/ifconfig "$interface" 0.0.0.0 2>/dev/null
    # The nameservers we wrote belong to this lease. Once the station is down
    # they are unreachable, and leaving them in place makes every lookup hang on
    # timeout rather than fail fast -- worse than having no resolver at all, which
    # is what the device shipped with. Remove only our own file.
    if grep -q "$MARK" "$RESOLV" 2>/dev/null; then
        rm -f "$RESOLV" 2>/dev/null
    fi
    rm -f "$TMPRESOLV" 2>/dev/null
    ;;
  leasefail|nak)
    echo "$(date '+%m-%d %H:%M:%S') dhcp $1 on $interface" >> "$LOG"
    ;;
esac
