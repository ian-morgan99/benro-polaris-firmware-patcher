{
    // Repo-generic settings only.
    //
    // Editor/assistant preferences (lmstudio.baseUrl, lmstudio.secondaryServers,
    // lmstudio.supervision.*) deliberately live in user-level settings, not here.
    // They encode machine-specific state - loopback/LAN endpoints, a CUDA device
    // choice and an absolute path to a local venv - which is wrong for anyone
    // else checking this repo out, and was the subject of the review note on
    // commit 5fdc174.
    //
    // The two lmstudio keys kept below carry no host identity and are not set at
    // user level, so removing them would silently change behaviour.
    "lmstudio.contextOverflow.preferBridgeCompaction": false,
    "lmstudio.syncChatLm": true,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/builds/**": true,
        "**/out/**": true,
        "**/container/testdata/fail_closed_stage/**": true,
        "**/.lmstudio-context/**": true,
        "**/docs/evidence/**/*.log": true
    },
    "search.exclude": {
        "**/builds/**": true,
        "**/out/**": true,
        "**/container/testdata/fail_closed_stage/**": true,
        "**/.lmstudio-context/**": true,
        "**/docs/evidence/**/*.log": true
    },
    "chat.experimentalModelPicker": false
}
